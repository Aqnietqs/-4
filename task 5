package main

import "fmt"

func main() {

	// Задание 1
	schooling := 11
	fmt.Println(schooling)

	schooling = 12
	fmt.Println(schooling)

	// Задание 2
	name := "Vladislav"
	fmt.Println(name)

	name = "Aqniet"
	fmt.Println(name)

	// Задание 3
	steps := 0
	fmt.Println(steps)

	steps = 2000
	fmt.Println(steps)
	fmt.Println("Хорошая работа! Вы уже на пути к своей ежедневной цели")

	// Задание 4
	largeNumber := 6000000
	fmt.Println(largeNumber)

	// Задание 5
	const breakTime = 15
	fmt.Println(breakTime)

	// breakTime = 20
	// Нельзя изменить значение, потому что breakTime объявлена как const.
	// Константы в Go фиксируются на этапе компиляции и не могут быть
	// переприсвоены — попытка сделать это вызовет ошибку компиляции:
	// cannot assign to breakTime (declared const)
}
